{
  "name": "gameventory",
  "version": "1.0.0",
  "private": true,
  "license": "GPL-3.0-only",
  "author": "Todd Johnson",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "pnpm build:client && pnpm build:server",
    "build:server": "tsup",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p e2e/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:e2e": "playwright test --config=e2e/playwright.config.ts",
    "verify": "pnpm lint && pnpm test && pnpm typecheck && pnpm build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "migrate:mongo": "tsx scripts/migrate-from-mongo.ts",
    "docker:build": "docker build -t gameventory ."
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@libsql/client": "^0.17.3",
    "@tanstack/react-query": "^5.100.6",
    "croner": "^10.0.1",
    "dompurify": "^3.4.11",
    "drizzle-orm": "^0.45.2",
    "fast-xml-parser": "^5.9.3",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "openid-client": "^6.8.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router-dom": "^7.18.0",
    "sonner": "^2.0.7",
    "undici": "^8.5.0",
    "zod": "^4.4.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/vite": "^4.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.0",
    "msw": "^2.14.2",
    "tailwindcss": "^4.2.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.1.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.10.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw"
    ],
    "overrides": {
      "esbuild@<0.28.1": ">=0.28.1",
      "shell-quote@<1.8.4": ">=1.8.4",
      "@babel/core@<7.29.6": "7.29.6",
      "undici@>=7.0.0 <7.28.0": "7.28.0",
      "minimatch@>=9.0.0 <9.0.9": "9.0.9",
      "minimatch@>=5.0.0 <5.1.8": "5.1.8",
      "ajv@>=7.0.0 <8.18.0": "8.18.0",
      "flatted": ">=3.4.2",
      "picomatch": ">=4.0.4",
      "lodash": ">=4.18.0",
      "fast-uri@<3.1.2": ">=3.1.2",
      "ip-address@<10.1.1": ">=10.1.1",
      "ws@<8.20.1": ">=8.20.1",
      "brace-expansion@>=1.0.0 <1.1.13": "1.1.13",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=5.0.0 <5.0.6": "5.0.6"
    }
  }
}
